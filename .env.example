# =====================================================================
# Vertica environment variables (EXAMPLE)
# Copy to .env.local and fill with your local Supabase values.
# NEVER commit .env.local or real secrets.
# =====================================================================

# --- Public (safe to expose to the browser) ---
# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable / anon key (RLS-protected, safe for the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Application public base URL (used for auth redirects, signed links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (NEVER expose to the browser) ---
# Service-role key. Server-only modules only. Must never appear in a
# client-importable file or the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Application timezone policy: store UTC, render in Asia/Manila
APP_TIMEZONE=Asia/Manila
