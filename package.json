{
  "name": "vertica",
  "version": "2.0.0",
  "private": true,
  "description": "Vertica - Web-Based Condominium Property-Management Information System",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify-env": "tsx scripts/verify-env.ts",
    "check": "npm run verify-env && npm run lint && npm run typecheck && npm run test",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:test": "supabase test db",
    "db:apply": "tsx scripts/db-apply.ts",
    "db:apply:one": "tsx scripts/db-apply.ts --only=0016_demo_operations_completion.sql",
    "db:apply:reset": "tsx scripts/db-apply.ts --reset --seed",
    "seed:users": "tsx --env-file=.env.local scripts/seed-demo-users.ts",
    "docs:dd": "tsx scripts/generate-data-dictionary.ts",
    "check:migrations": "tsx scripts/check-migration-order.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "three": "^0.180.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.180.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.0",
    "pg": "^8.22.0",
    "postcss": "8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
